# ---------------------------------------------------------------------
# Docker Traefik Portainer - Environment Configuration
# ---------------------------------------------------------------------
# Copie este arquivo para .env e edite os valores
# Ou use o script: sudo ./interactive-setup.sh

# Containers
TRAEFIK_CONTAINER_NAME=traefik
PORTAINER_CONTAINER_NAME=portainer

# Portas
HTTP_PORT=80
HTTPS_PORT=443

# Domínios (gerados automaticamente pelo script)
TRAEFIK_DOMAIN=traefik.seu-dominio.com
PORTAINER_DOMAIN=portainer.seu-dominio.com

# Let's Encrypt
LETSENCRYPT_EMAIL=seu.email@dominio.com

# BasicAuth (gerado automaticamente pelo script)
# Formato: usuario:$$2y$$05$$...hash...
BASIC_AUTH_USERS=admin:$$2y$$05$$exemplo...

# Timezone
TZ=America/Sao_Paulo
